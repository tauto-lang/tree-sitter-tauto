# Ignore everything, then list what is published.
*
!*/
!.gitignore

# Documents and licenses
!/README.md
!/LICENSE-MIT
!/LICENSE-APACHE
!/LICENSE-TREE-SITTER

# Grammar and queries
!/grammar.js
!/tree-sitter.json
!/queries/*.scm

# Generated by `tree-sitter generate`
!/src/grammar.json
!/src/node-types.json
!/src/parser.c
!/src/tree_sitter/*.h

# Tests
!/test/corpus/*.txt

# Dependencies (pnpm)
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
